<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:drawable="@drawable/bg_shortcut_option_selector_top_normal" />
            <item>
                <shape>
                    <solid android:color="@color/list_item_bg_pressed" />
                    <corners android:topLeftRadius="20.0dp" android:topRightRadius="20.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <item android:drawable="@drawable/bg_shortcut_option_selector_top_normal" />
            <item>
                <shape>
                    <solid android:color="@color/list_item_bg_hovered" />
                    <corners android:topLeftRadius="20.0dp" android:topRightRadius="20.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/bg_shortcut_option_selector_top_normal" />
</selector>
